{
  "name": "caba-transparente",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "scrape": "bun packages/scrapers/src/cli.ts",
    "archivar": "bun packages/scrapers/src/archive-org.ts",
    "probar-acceso": "bun packages/scrapers/src/check-access.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
